{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SNine Launcher",
  "version": "1.0.9",
  "identifier": "site.s9lab.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SNine Launcher",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: https://crafatar.com https://mc-heads.net https://textures.minecraft.net; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://login.microsoftonline.com https://user.auth.xboxlive.com https://xsts.auth.xboxlive.com https://api.minecraftservices.com https://piston-meta.mojang.com https://piston-data.mojang.com https://launchermeta.mojang.com https://libraries.minecraft.net https://resources.download.minecraft.net https://meta.fabricmc.net https://api.modrinth.com https://cdn.modrinth.com https://crafatar.com https://mc-heads.net"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "SNine",
    "category": "Game",
    "shortDescription": "Official SNine Minecraft Launcher",
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "designsnc"
        ],
        "name": "SNine Design Profile",
        "description": "SNine Launcher Farb- und Designprofil",
        "role": "Editor",
        "mimeType": "application/x-snine-design"
      }
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEExRDFGNUQ5QjQyMkY3NEYKUldSUDl5SzAyZlhSb2VzWXgzc1VmV3Jjdm5jSHo5NVRTWVFWQ1hiZ0VXR1RFck5OUEJQNkpiTlEK",
      "endpoints": [
        "https://github.com/silas9k/SNine-Launcher/releases/latest/download/latest.json"
      ]
    }
  }
}
