{
  "name": "s9lab-launcher",
  "private": true,
  "version": "1.0.8",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "check:utf8": "node scripts/check-utf8.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:security": "node scripts/check-security-config.mjs",
    "check:registry": "node scripts/check-public-registry.mjs",
    "check:source-clean": "node scripts/check-source-cleanliness.mjs",
    "check:workflows": "node scripts/check-workflow-guards.mjs",
    "check:versions": "node scripts/check-version-sync.mjs",
    "check:ipc": "node scripts/check-ipc-contracts.mjs",
    "test": "npm run check:utf8 && npm run check:secrets && npm run check:security && npm run check:registry && npm run check:workflows && npm run check:versions && npm run check:ipc-generated && npm run check:ipc && npm run check:rust-static && npm run check:phase1 && npm run check:phase3 && npm run check:phase4 && npm run check:phase5 && npm run check:phase6 && npm run check:phase7 && npm run check:i18n && npm run check:visible-text && npm run check:design-system && npm run test:node && npm run test:unit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "check:rust-static": "node scripts/check-rust-static.mjs",
    "generate:ipc": "node scripts/generate-ipc-contracts.mjs",
    "check:ipc-generated": "node scripts/generate-ipc-contracts.mjs --check",
    "check:phase1": "node scripts/check-phase1-foundation.mjs",
    "check:phase3": "node scripts/check-phase3-auth-security.mjs",
    "check:phase4": "node scripts/check-phase4-profile-isolation.mjs",
    "check:phase5": "node scripts/check-phase5-runtime-security.mjs",
    "check:phase6": "node scripts/check-phase6-content-security.mjs",
    "check:phase7": "node scripts/check-phase7-update-security.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:visible-text": "node scripts/check-visible-text.mjs",
    "check:design-system": "node scripts/check-design-system.mjs",
    "test:unit": "vitest run",
    "test:node": "node --test tests/node/check-public-registry.test.mjs tests/node/source-cleanliness.test.mjs tests/node/workflow-guards.test.mjs tests/node/browser-utils.test.mjs tests/node/windows-verifier.test.mjs tests/node/phase3-auth-security.test.mjs tests/node/phase4-profile-isolation.test.mjs tests/node/phase6-content-security.test.mjs tests/node/phase7-update-security.test.mjs",
    "test:browser": "node scripts/run-phase2-browser-tests.mjs",
    "test:visual": "node scripts/run-phase2-browser-tests.mjs",
    "test:performance": "node scripts/run-performance-harness.mjs",
    "verify:phase2": "npm run build && npm run test:browser && npm run test:performance"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "skinview3d": "^3.4.2",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.10.3",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.55.0",
    "typescript": "~5.8.3",
    "vite": "^6.1.0",
    "vitest": "^3.2.4",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
